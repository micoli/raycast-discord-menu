{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-discord-menu",
  "title": "Discord",
  "description": "Discord remote commands",
  "icon": "discord_1.png",
  "author": "micoli",
  "license": "MIT",
  "commands": [
    {
      "name": "ddiscord-stream-screen-1",
      "title": "Stream Screen 1",
      "description": "Start stream on screen 1",
      "keywords": [
        "discord",
        "stream",
        "start",
        "screen"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-stream-screen-2",
      "title": "Stream Screen 2",
      "description": "Start stream on screen 2",
      "keywords": [
        "discord",
        "stream",
        "start",
        "screen"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-stop-stream",
      "title": "Stop Stream",
      "description": "Stop stream (1 or 2)",
      "keywords": [
        "discord",
        "stream",
        "stop",
        "screen"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-toggle-microphone",
      "title": "Toggle Microphone",
      "description": "Toggle microphone mute",
      "keywords": [
        "discord",
        "toggle",
        "microphone",
        "mute"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-toggle-speaker",
      "title": "Toggle Speaker",
      "description": "Toggle speaker",
      "keywords": [
        "discord",
        "toggle",
        "speaker"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-mute",
      "title": "Mute Microphone",
      "description": "Mute microphone (no-op if already muted)",
      "keywords": [
        "discord",
        "mute",
        "microphone"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-unmute",
      "title": "Unmute Microphone",
      "description": "Unmute microphone (no-op if already unmuted)",
      "keywords": [
        "discord",
        "unmute",
        "microphone"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-deafen",
      "title": "Deafen",
      "description": "Deafen: mute headset and microphone",
      "keywords": [
        "discord",
        "deafen",
        "speaker",
        "sourdine"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-undeafen",
      "title": "Undeafen",
      "description": "Undeafen: restore headset sound",
      "keywords": [
        "discord",
        "undeafen",
        "speaker",
        "sourdine"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-voice-members",
      "title": "Voice Members",
      "description": "Who is connected in the current voice channel",
      "keywords": [
        "discord",
        "voice",
        "members",
        "who"
      ],
      "mode": "view"
    },
    {
      "name": "ddiscord-launch-discord",
      "title": "Launch Discord",
      "description": "Launch discord with remote debugging (relaunches it if it runs without)",
      "keywords": [
        "discord",
        "launch",
        "remote"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-stop-discord",
      "title": "Stop Discord",
      "description": "Quit discord",
      "keywords": [
        "discord",
        "stop",
        "quit",
        "kill"
      ],
      "mode": "no-view"
    },
    {
      "name": "ddiscord-menu",
      "title": "Commands Menu",
      "description": "Shortcuts for discord stream",
      "mode": "menu-bar",
      "interval": "1m"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.84.3",
    "@raycast/utils": "^1.17.0",
    "node-fetch": "^3.3.0",
    "vite": "^5.4.9",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "20.8.10",
    "@types/react": "18.3.3",
    "@types/ws": "^8.5.12",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5",
    "wait-port": "^1.1.0"
  },
  "scripts": {
    "build": "npm run build-inject && ray build",
    "dev": "npm run build-inject && ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish",
    "build-inject": "vite build && npm run build-watcher",
    "watch-inject": "vite build --watch",
    "build-icons": "node scripts/build-menu-icons.mjs",
    "build-watcher": "esbuild src/watcher/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=assets/discord-watcher.js"
  }
}
